{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.tsuyoshishirota.com"
        }
      ],
      "destination": "https://tsuyoshishirota.com/$1",
      "permanent": true
    },
    {
      "source": "/post/:slug",
      "destination": "/blog/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/seo-weekly",
      "schedule": "0 0 * * 1"
    }
  ],
  "functions": {
    "api/webhook.js": {
      "maxDuration": 60
    },
    "api/generate-post.js": {
      "maxDuration": 60
    },
    "api/ocr-receipt.js": {
      "maxDuration": 30
    },
    "api/auth-check.js": {
      "maxDuration": 5
    },
    "api/publish-post.js": {
      "maxDuration": 30
    },
    "api/seo-weekly.js": {
      "maxDuration": 120
    }
  }
}
