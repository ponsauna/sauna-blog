---
import {
  DEFAULT_OG_IMAGE,
  HOME_META_DESCRIPTION,
  OWNER_NAME,
  SITE_ORIGIN,
  imageMimeType,
  normalizeMetaDescription,
  normalizeMetaText,
} from '../../lib/site-metadata.js';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: string;
  canonicalUrl?: string;
  publishedDate?: string;
  modifiedDate?: string;
  articleSection?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description = HOME_META_DESCRIPTION,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = `${OWNER_NAME}のサイト`,
  ogImageWidth,
  ogImageHeight,
  ogType = 'website',
  canonicalUrl,
  publishedDate,
  modifiedDate,
  articleSection,
  jsonLd,
  noindex = false,
} = Astro.props;

const normalizedPath = Astro.url.pathname === '/'
  ? '/'
  : Astro.url.pathname.replace(/\/+$/, '');
const showAdSense = normalizedPath === '/blog' || normalizedPath.startsWith('/blog/');
const canonical = canonicalUrl ?? `${SITE_ORIGIN}${normalizedPath}`;
const metaTitle = normalizeMetaText(title);
const metaDescription = normalizeMetaDescription(description);
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${SITE_ORIGIN}${ogImage}`;
const robots = noindex
  ? 'noindex, nofollow, noarchive'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: OWNER_NAME,
  alternateName: '小さなお店のAI自動化',
  url: SITE_ORIGIN,
  inLanguage: 'ja-JP',
};
const jsonLdItems = [websiteLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Primary Meta -->
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={OWNER_NAME} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f5f1e8" />
    <meta name="google-site-verification" content="9ZNZ4_KY6oI7QUnw2bmeqzkRk7vEsZqFxlp1PGBKYCQ" />

    <!-- OGP -->
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:secure_url" content={ogImageAbsolute} />
    <meta property="og:image:type" content={imageMimeType(ogImage)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={OWNER_NAME} />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
    {ogType === 'article' && <meta property="article:author" content={OWNER_NAME} />}
    {articleSection && <meta property="article:section" content={articleSection} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="apple-touch-icon" href="/favicon.jpg" />

    <!-- JSON-LD -->
    {jsonLdItems.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <slot name="head" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GDS1HB0PNK"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-GDS1HB0PNK');
    </script>

    <!-- Google AdSense: sauna blog only -->
    {showAdSense && (
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3705985032450985" crossorigin="anonymous"></script>
    )}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Zen+Old+Mincho:wght@600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans min-h-screen flex flex-col">
    <slot name="header" />
    <main class="flex-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
