---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { HOME_META_DESCRIPTION, HOME_META_TITLE } from '../../lib/site-metadata.js';

const siteUrl = 'https://tsuyoshishirota.com';
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: '城田 剛',
  alternateName: 'Tsuyoshi Shirota',
  url: siteUrl,
  image: `${siteUrl}/images/tsuyoshi-shirota.jpg`,
  jobTitle: 'プロダクトマネージャー・AI業務自動化支援',
  description: 'カフェやジムなど、小さなお店のAI自動化を支援。売上集計、データ転記、月次レポートなどの手作業を、現場に合う仕組みに変えます。',
  sameAs: [
    'https://note.com/pon_localization',
    'https://www.neppashi.com',
  ],
};
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '小さなお店のAI自動化',
  serviceType: 'AIを活用した業務自動化支援',
  url: siteUrl,
  description: HOME_META_DESCRIPTION,
  provider: {
    '@type': 'Person',
    name: '城田 剛',
    url: siteUrl,
  },
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'カフェやジムなどの小規模店舗オーナー',
  },
  areaServed: 'JP',
};

const concerns = [
  '複数店舗の売上を、毎月ひとつのExcelへまとめている',
  '同じ内容を、予約システムや別の表へ何度も入力している',
  '数字を確認したいのに、集計が終わるまで状況が分からない',
];

const steps = [
  {
    number: '01',
    title: '自動化する仕事を決める',
    body: '毎月繰り返す集計や転記など、時間のかかる手作業を確認し、AIに任せる仕事を一つ決めます。',
  },
  {
    number: '02',
    title: 'AIで仕組みを作る',
    body: 'データを読み取り、必要な場所へ移し、集計やレポートまで行う流れを自動化します。',
  },
  {
    number: '03',
    title: '現場で使える形にする',
    body: '実際のデータで試し、ボタン一つや決まった時刻に動く、無理なく続けられる形にします。',
  },
];

const career = [
  {
    company: '楽天株式会社',
    body: '小さな商店の売上づくりを支援。',
  },
  {
    company: 'X',
    body: '誰もが広告を配信できる仕組みに携わる。',
  },
  {
    company: 'Wix',
    body: '誰もが手頃な価格で、自分の思いを伝えるWebサイトを作れるよう支援。',
  },
  {
    company: '現在',
    body: '誰もが自分の伝えたいことを形にできる、デザインツールに携わる。',
  },
];

const faqs = [
  {
    question: 'まだ何を自動化したいか決まっていません。',
    answer: '大丈夫です。普段の仕事を伺い、AIに任せられる作業をこちらで見つけて、最初に自動化する一つをご提案します。',
  },
  {
    question: '新しいシステムを導入する必要がありますか？',
    answer: '必須ではありません。いま使っているExcelやスプレッドシート、業務サービスを生かせる方法から検討します。',
  },
  {
    question: '小さなお店でも相談できますか？',
    answer: 'むしろ、専任のIT担当者がいない小さな会社や店舗のお力になりたいと考えています。まずは今の状況をお聞かせください。',
  },
];
---

<BaseLayout
  title={HOME_META_TITLE}
  description={HOME_META_DESCRIPTION}
  ogImage="/images/tsuyoshi-shirota.jpg"
  ogImageAlt="緑の木々を背景に立つ城田剛"
  ogImageWidth={1200}
  ogImageHeight={1800}
  jsonLd={[personLd, serviceLd]}
>
  <Header slot="header" />

  <section class="hero" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">小さなお店のAI自動化</p>
        <h1 id="hero-title">毎月の手作業を、<br />AIで自動化する。</h1>
        <p class="lead">
          売上集計、Excelへの転記、月次レポート。<br class="desktop-break" />
          AIがデータを読み、まとめ、必要な形にする仕組みを、いまの仕事に合わせて作ります。
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#contact">自動化したい作業を相談する</a>
          <span>まずは状況を聞かせてください</span>
        </div>
      </div>
      <figure class="portrait-wrap">
        <img
          src="/images/tsuyoshi-shirota.jpg"
          alt="緑の木々を背景に立つ城田剛"
          width="1200"
          height="1800"
          class="portrait"
        />
        <figcaption>城田 剛｜会社員としてプロダクト開発・業務改善に携わっています</figcaption>
      </figure>
    </div>
  </section>

  <section class="section concerns" aria-labelledby="concerns-title">
    <div class="shell narrow-shell">
      <p class="eyebrow">よくあるご相談</p>
      <h2 id="concerns-title">こんな作業、ありませんか。</h2>
      <div class="concern-list">
        {concerns.map((concern, index) => (
          <div class="concern-row">
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <p>{concern}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="service" class="section service" aria-labelledby="service-title">
    <div class="shell service-intro">
      <div>
        <p class="eyebrow">できること</p>
        <h2 id="service-title">AIに任せる仕事を、<br />ひとつずつ増やします。</h2>
      </div>
      <p>
        AIが売上データを読み、別の表へ移し、集計してレポートを作る。そんな自動化を、いま使っているExcelやサービスに合わせて作ります。
        高価なシステムを入れ替えることが前提ではありません。
      </p>
    </div>
    <div class="shell step-list">
      {steps.map((step) => (
        <article class="step-row">
          <span class="step-number">{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="case" class="section case" aria-labelledby="case-title">
    <div class="shell case-heading">
      <p class="eyebrow">つくったもの</p>
      <h2 id="case-title">思いつきを、使われる仕組みに。</h2>
    </div>
    <div class="shell case-card">
      <div class="case-visual" aria-label="熱波師.COMの機能イメージ">
        <div class="case-browser-bar">
          <span></span><span></span><span></span>
          <p>neppashi.com</p>
        </div>
        <div class="case-screen">
          <p class="case-logo">熱波師.COM</p>
          <p class="case-screen-title">全国の熱波師を、地域から探す。</p>
          <div class="case-search">熱波師名・活動地域で検索 <span>⌕</span></div>
          <div class="case-results">
            <span>北海道</span><span>関東</span><span>近畿</span><span>九州</span>
          </div>
          <p class="case-count">150名以上のプロフィールを掲載</p>
        </div>
      </div>
      <div class="case-copy">
        <p class="case-label">自主プロジェクト</p>
        <h3>熱波師.COM</h3>
        <p>
          「出演したい熱波師」と「依頼したいサウナ施設」が、SNSでは出会いにくい。そのすれ違いを減らすために作った、熱波師のプロフィール検索サービスです。
        </p>
        <dl class="case-details">
          <div><dt>探せる</dt><dd>名前や活動地域から検索</dd></div>
          <div><dt>伝わる</dt><dd>活動情報やSNSを一ページに整理</dd></div>
          <div><dt>つながる</dt><dd>施設から本人へ直接相談</dd></div>
        </dl>
        <p class="case-note">Webサイトだけでなく、情報を集め、整理し、必要な人が使える形にするところまで作れます。</p>
        <a class="text-link" href="https://www.neppashi.com" target="_blank" rel="noreferrer">
          熱波師.COMを見る<span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section id="about" class="section about" aria-labelledby="about-title">
    <div class="shell about-grid">
      <div class="about-heading">
        <p class="eyebrow">これまでと、これから</p>
        <h2 id="about-title">小さなお店の力になる。それが、ずっと仕事の軸でした。</h2>
      </div>
      <div class="about-copy">
        <p>
          私の両親は、二人でガソリンスタンドを営んでいます。現場の仕事に加えて、売上管理や事務まで自分たちで担う姿を見てきました。
        </p>
        <p>私自身も、仕事では一貫して、小さな事業者がテクノロジーを使って前に進める状態をつくってきました。</p>
        <div class="career-list" aria-label="これまでの仕事">
          {career.map((item) => (
            <div class="career-row">
              <strong>{item.company}</strong>
              <span>{item.body}</span>
            </div>
          ))}
        </div>
        <p class="about-closing">
          会社や扱うサービスは変わっても、その軸は変わりませんでした。だから今、AIを使って、両親のように現場と事務を自分たちで背負う人の力になりたいと思っています。
        </p>
        <a class="text-link" href="https://note.com/pon_localization" target="_blank" rel="noreferrer">
          noteで制作と試行錯誤を読む<span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section faq" aria-labelledby="faq-title">
    <div class="shell faq-grid">
      <div>
        <p class="eyebrow">よくある質問</p>
        <h2 id="faq-title">相談の前に。</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}<span aria-hidden="true">＋</span></summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="shell contact-grid">
      <div>
        <p class="eyebrow light">お問い合わせ</p>
        <h2 id="contact-title">その手作業、AIに任せられるかもしれません。</h2>
        <p class="contact-lead">毎月繰り返している集計、転記、確認、レポート作成などを教えてください。自動化できる方法を考えます。</p>
      </div>
      <div class="contact-action">
        <p class="contact-time">入力は3分ほど</p>
        <p>お名前と連絡先、AIで自動化したい作業を伺います。まだ具体的でなくても大丈夫です。2〜3営業日を目安に城田からご連絡します。</p>
        <a
          class="button button-contact"
          href="https://docs.google.com/forms/d/e/1FAIpQLSewdmS_pSjJh0LF-KO2BsjW0myrnp2NB22J7Ia7mBuuTGvjnw/viewform?usp=publish-editor"
          target="_blank"
          rel="noreferrer"
        >
          Googleフォームで相談する<span aria-hidden="true">↗</span>
        </a>
        <p class="form-note">顧客名簿や売上データなどの機密情報は、フォームには記載しないでください。</p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { background: #f5f1e8; color: #202821; }
  :global(*) { box-sizing: border-box; }
  .shell { width: min(1120px, calc(100% - 64px)); margin: 0 auto; }
  .narrow-shell { max-width: 920px; }
  .section { padding: 112px 0; }
  .eyebrow { margin: 0 0 22px; color: #294b37; font-size: 13px; font-weight: 700; letter-spacing: .16em; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { margin-bottom: 30px; font-size: clamp(44px, 5.2vw, 72px); line-height: 1.2; letter-spacing: -.045em; font-weight: 700; }
  h2 { margin-bottom: 0; font-size: clamp(32px, 3.5vw, 48px); line-height: 1.35; letter-spacing: -.035em; font-weight: 700; }
  h3 { font-size: 25px; line-height: 1.5; font-weight: 700; }
  p { font-size: 17px; line-height: 1.9; }
  .hero { padding: 132px 0 82px; background: #fffdf8; }
  .hero-grid { display: grid; grid-template-columns: 1.13fr .87fr; align-items: center; gap: 72px; }
  .hero-copy { padding-bottom: 30px; }
  .lead { max-width: 600px; margin-bottom: 38px; color: #4c564e; font-size: 18px; }
  .hero-actions { display: flex; align-items: center; gap: 20px; }
  .hero-actions span { color: #687169; font-size: 13px; }
  .button { display: inline-flex; min-height: 54px; align-items: center; justify-content: center; border: 1px solid transparent; border-radius: 6px; padding: 14px 24px; font-size: 15px; font-weight: 700; text-decoration: none; transition: background-color .2s ease, color .2s ease, border-color .2s ease; }
  .button-primary { background: #b85f3d; color: #fffdf8; }
  .button-primary:hover { background: #984a2f; }
  .portrait-wrap { margin: 0; }
  .portrait { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 34%; }
  figcaption { margin-top: 12px; color: #687169; font-size: 12px; line-height: 1.6; }
  .concerns { background: #f5f1e8; }
  .concern-list { margin-top: 58px; border-top: 1px solid #d8d1c4; }
  .concern-row { display: grid; grid-template-columns: 72px 1fr; gap: 24px; align-items: start; padding: 28px 0; border-bottom: 1px solid #d8d1c4; }
  .concern-row span { padding-top: 5px; color: #9a5d45; font-size: 13px; font-weight: 700; }
  .concern-row p { margin: 0; font-size: 21px; line-height: 1.65; }
  .service { background: #294b37; color: #fffdf8; }
  .service .eyebrow { color: #e4b39c; }
  .service-intro { display: grid; grid-template-columns: 1.05fr .95fr; gap: 96px; align-items: end; }
  .service-intro > p { margin-bottom: 4px; color: #dce6de; }
  .step-list { margin-top: 76px; border-top: 1px solid rgba(255,255,255,.24); }
  .step-row { display: grid; grid-template-columns: 90px 230px 1fr; gap: 26px; align-items: start; padding: 34px 0; border-bottom: 1px solid rgba(255,255,255,.24); }
  .step-number { padding-top: 7px; color: #e4b39c; font-size: 13px; font-weight: 700; }
  .step-row h3, .step-row p { margin-bottom: 0; }
  .step-row p { color: #dce6de; }
  .text-link { display: inline-flex; gap: 7px; align-items: center; color: #294b37; font-size: 14px; font-weight: 700; text-decoration: underline; text-underline-offset: 5px; }
  .case { background: #fffdf8; }
  .case-heading { display: grid; grid-template-columns: .45fr 1.55fr; gap: 50px; align-items: start; margin-bottom: 54px; }
  .case-card { display: grid; grid-template-columns: 1.08fr .92fr; overflow: hidden; border: 1px solid #d8d1c4; background: #f5f1e8; }
  .case-visual { min-height: 510px; padding: 50px; background: #b85f3d; }
  .case-browser-bar { display: flex; height: 42px; align-items: center; gap: 7px; border-radius: 8px 8px 0 0; padding: 0 15px; background: #eee9e0; }
  .case-browser-bar > span { width: 7px; height: 7px; border-radius: 50%; background: #b9b1a6; }
  .case-browser-bar p { margin: 0 0 0 9px; color: #706b63; font-size: 10px; line-height: 1; }
  .case-screen { min-height: 365px; border-radius: 0 0 8px 8px; padding: 34px; background: #fffdf8; box-shadow: 0 22px 42px rgba(67,35,25,.18); }
  .case-logo { margin-bottom: 48px; color: #202821; font-size: 12px; font-weight: 800; letter-spacing: .08em; }
  .case-screen-title { max-width: 360px; margin-bottom: 26px; color: #202821; font-size: 28px; font-weight: 700; line-height: 1.4; letter-spacing: -.03em; }
  .case-search { display: flex; min-height: 48px; align-items: center; justify-content: space-between; border: 1px solid #d8d1c4; border-radius: 4px; padding: 0 16px; color: #7c837d; font-size: 12px; }
  .case-search span { color: #b85f3d; font-size: 19px; }
  .case-results { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 15px; }
  .case-results span { border-radius: 50px; padding: 7px 12px; background: #e9e3d8; color: #465048; font-size: 10px; font-weight: 700; }
  .case-count { margin: 25px 0 0; color: #687169; font-size: 11px; }
  .case-copy { align-self: center; padding: 58px 56px; }
  .case-label { margin-bottom: 10px; color: #9a5d45; font-size: 12px; font-weight: 700; letter-spacing: .12em; }
  .case-copy h3 { margin-bottom: 24px; font-size: 34px; }
  .case-copy > p { color: #465048; font-size: 15px; }
  .case-details { margin: 30px 0; border-top: 1px solid #d8d1c4; }
  .case-details div { display: grid; grid-template-columns: 82px 1fr; gap: 20px; padding: 14px 0; border-bottom: 1px solid #d8d1c4; }
  .case-details dt { color: #294b37; font-size: 13px; font-weight: 700; }
  .case-details dd { margin: 0; color: #465048; font-size: 13px; }
  .case-note { font-weight: 700; }
  .case-copy .text-link { margin-top: 12px; }
  .about { background: #e9e3d8; }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 100px; }
  .about-copy p { color: #3d473f; }
  .career-list { margin: 34px 0; border-top: 1px solid #c9c0b2; }
  .career-row { display: grid; grid-template-columns: 110px 1fr; gap: 20px; padding: 17px 0; border-bottom: 1px solid #c9c0b2; }
  .career-row strong { color: #294b37; font-size: 14px; }
  .career-row span { color: #3d473f; font-size: 14px; line-height: 1.75; }
  .about-closing { margin-top: 30px; }
  .about-copy .text-link { margin-top: 14px; }
  .faq { background: #f5f1e8; }
  .faq-grid { display: grid; grid-template-columns: .7fr 1.3fr; gap: 96px; }
  .faq-list { border-top: 1px solid #d8d1c4; }
  details { border-bottom: 1px solid #d8d1c4; }
  summary { display: flex; min-height: 76px; cursor: pointer; align-items: center; justify-content: space-between; gap: 20px; list-style: none; font-size: 17px; font-weight: 700; }
  summary::-webkit-details-marker { display: none; }
  summary span { font-size: 20px; font-weight: 400; }
  details[open] summary span { transform: rotate(45deg); }
  details p { max-width: 650px; padding: 0 46px 24px 0; color: #4c564e; font-size: 15px; }
  .contact { padding: 112px 0; background: #202821; color: #fffdf8; }
  .contact-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 96px; }
  .eyebrow.light { color: #e4b39c; }
  .contact-lead { max-width: 470px; margin-top: 28px; color: #cbd4cd; }
  .contact-action { align-self: center; border-top: 1px solid #657168; border-bottom: 1px solid #657168; padding: 34px 0; }
  .contact-action > p { max-width: 580px; color: #d7dfd9; }
  .contact-time { margin-bottom: 12px; color: #e4b39c !important; font-size: 13px; font-weight: 700; }
  .button-contact { display: inline-flex; margin-top: 14px; gap: 10px; background: #b85f3d; color: #fff; }
  .button-contact:hover { background: #cc6c48; }
  .form-note { margin: 18px 0 0; color: #aeb8b0 !important; font-size: 12px; line-height: 1.7; }
  @media (max-width: 900px) {
    .shell { width: min(100% - 40px, 720px); }
    .section { padding: 76px 0; }
    .hero { padding: 106px 0 64px; }
    .hero-grid, .service-intro, .case-heading, .case-card, .about-grid, .faq-grid, .contact-grid { grid-template-columns: 1fr; gap: 46px; }
    .hero-copy { padding-bottom: 0; }
    .portrait-wrap { max-width: 540px; }
    .step-row { grid-template-columns: 54px 160px 1fr; }
  }
  @media (max-width: 640px) {
    .shell { width: calc(100% - 40px); }
    .section { padding: 64px 0; }
    h1 { font-size: 38px; line-height: 1.32; letter-spacing: -.035em; }
    h2 { font-size: 29px; }
    p { font-size: 16px; }
    .desktop-break { display: none; }
    .hero-grid { gap: 36px; }
    .lead { font-size: 16px; }
    .hero-actions { align-items: stretch; flex-direction: column; gap: 11px; }
    .hero-actions span { text-align: center; }
    .portrait-wrap { width: calc(100% + 40px); margin-left: -20px; }
    .portrait-wrap figcaption { padding: 0 20px; }
    .concern-list { margin-top: 42px; }
    .concern-row { grid-template-columns: 42px 1fr; gap: 12px; padding: 23px 0; }
    .concern-row p { font-size: 18px; }
    .step-list { margin-top: 50px; }
    .step-row { grid-template-columns: 42px 1fr; gap: 8px 12px; }
    .step-row h3 { font-size: 21px; }
    .step-row p { grid-column: 2; font-size: 15px; }
    .case-heading { gap: 0; margin-bottom: 36px; }
    .case-visual { min-height: auto; padding: 26px 20px; }
    .case-screen { min-height: 330px; padding: 25px 22px; }
    .case-logo { margin-bottom: 38px; }
    .case-screen-title { font-size: 24px; }
