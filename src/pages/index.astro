---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { HOME_META_DESCRIPTION, HOME_META_TITLE } from '../../lib/site-metadata.js';

const siteUrl = 'https://tsuyoshishirota.com';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: '城田 剛',
  alternateName: 'Tsuyoshi Shirota',
  url: siteUrl,
  image: `${siteUrl}/images/tsuyoshi-shirota.jpg`,
  jobTitle: 'プロダクトマネージャー・AI業務自動化支援',
  description: 'カフェやジムなど、小さなお店のAI自動化を支援。売上集計、データ転記、月次レポートなどの手作業を、現場に合う仕組みに変えます。',
  sameAs: ['https://note.com/pon_localization', 'https://www.neppashi.com'],
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '小さなお店のAI自動化',
  serviceType: 'AIを活用した業務自動化支援',
  url: siteUrl,
  description: HOME_META_DESCRIPTION,
  provider: { '@type': 'Person', name: '城田 剛', url: siteUrl },
  audience: { '@type': 'BusinessAudience', audienceType: 'カフェやジムなどの小規模店舗オーナー' },
  areaServed: 'JP',
};

const manualTasks = [
  '複数店舗の売上を、毎月ひとつの表へまとめる',
  '予約や顧客情報を、別のシステムへ入力し直す',
  '数字の変化を知るために、いくつもの画面を確認する',
];

const processSteps = [
  { number: '01', title: '無料で相談する', body: '困っている作業や、毎月繰り返している仕事を伺います。' },
  { number: '02', title: '試しにつくる', body: '時間のかかる仕事を一つ選び、小さく動かします。' },
  { number: '03', title: '使って直す', body: '実際の仕事で試し、現場に合うよう調整します。' },
];

const career = [
  { company: '楽天株式会社', body: '小さな商店の売上づくりを支援' },
  { company: 'X', body: '誰もが広告を届けられる仕組みに携わる' },
  { company: 'Wix', body: '思いを伝えるWebサイトづくりを支援' },
  { company: '現在', body: '誰もが思いを形にできるデザインツールに携わる' },
];

const faqs = [
  {
    question: '何を自動化したいか決まっていません。',
    answer: '「毎回これが面倒」という話からで大丈夫です。仕事を伺い、AIに任せられそうな一つを一緒に探します。',
  },
  {
    question: '新しいシステムが必要ですか？',
    answer: '必須ではありません。いま使っているExcel、スプレッドシート、フォームなどを生かす方法から考えます。内容によっては、ChatGPTなどのAIツールを利用する場合があります。',
  },
  {
    question: 'AIは間違えませんか？',
    answer: 'AIは間違えることがあります。最初からすべてを無人にせず、人が確認する場所を残して設計します。',
  },
];
---

<BaseLayout
  title={HOME_META_TITLE}
  description={HOME_META_DESCRIPTION}
  ogImage="/images/tsuyoshi-shirota.jpg"
  ogImageAlt="緑の木々を背景に立つ城田剛"
  ogImageWidth={1200}
  ogImageHeight={1800}
  jsonLd={[personLd, serviceLd]}
>
  <Header slot="header" />

  <section class="audience-gateway" aria-labelledby="gateway-title">
    <div class="shell gateway-inner">
      <p class="label">AIで、仕事を少し軽くする。</p>
      <h1 id="gateway-title">
        <span class="desktop-title">相談したいのは、どちらですか。</span>
        <span class="mobile-title">相談したいのは、<br />どちらですか。</span>
      </h1>
      <p class="gateway-lead">お店の運営も、会社での仕事も。いま繰り返している作業を伺い、AIをどう使えるか一緒に考えます。</p>
      <div class="audience-options" aria-label="相談内容を選ぶ">
        <a class="audience-option business-option" href="#store">
          <span class="option-label">お店・個人事業主の方</span>
          <strong>閉店後まで続く仕事を、<br />減らしたい。</strong>
          <p>売上集計、予約情報の転記、月次報告などを自動化したい方へ。</p>
          <span class="option-link">お店のAI自動化を見る ↓</span>
        </a>
        <a class="audience-option personal-option" href="/personal">
          <span class="option-label">会社員の方</span>
          <strong>自分の仕事に合う、<br />AIの使い方を知りたい。</strong>
          <p>仕事でAIを使いたいけれど、事例や具体的な方法が分からない方へ。</p>
          <span class="option-link">会社員向けAI相談を見る →</span>
        </a>
      </div>
    </div>
  </section>

  <section id="store" class="hero" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="label">小さなお店のAI自動化</p>
        <h1 id="hero-title">
          <span class="desktop-title">閉店後まで続く仕事を、減らす。</span>
          <span class="mobile-title">閉店後まで続く<br />仕事を、減らす。</span>
        </h1>
        <p class="hero-lead">
          店舗ごとの売上をまとめる。予約情報を別の表へ写す。月次報告をつくる。<br class="desktop-only" />
          毎回同じように繰り返す仕事を、いま使っている道具とAIで自動化します。
        </p>
        <a class="button primary-button" href="#contact">まずは無料で相談する</a>
        <p class="button-note">相談は無料です。カフェ・ジム・サロンなど、小さなお店のお話を伺います。</p>
      </div>
      <figure class="hero-portrait">
        <img src="/images/tsuyoshi-shirota.jpg" alt="緑の木々を背景に立つ城田剛" width="1200" height="1800" />
        <figcaption>城田 剛｜プロダクト開発と業務改善に携わっています</figcaption>
      </figure>
    </div>
  </section>

  <section id="service" class="section manual" aria-labelledby="manual-title">
    <div class="shell section-heading">
      <p class="label">残っている手作業</p>
      <div>
        <h2 id="manual-title">こんな仕事が、閉店後まで残っていませんか。</h2>
        <p class="intro">必要な仕事ではあっても、店長が毎回手でやる必要はないかもしれません。</p>
      </div>
    </div>
    <div class="shell ruled-list">
      {manualTasks.map((task, index) => (
        <div class="ruled-row"><span>{String(index + 1).padStart(2, '0')}</span><p>{task}</p></div>
      ))}
    </div>
  </section>

  <section class="section process" aria-labelledby="process-title">
    <div class="shell">
      <div class="compact-heading">
        <p class="label">進め方</p>
        <h2 id="process-title">
          <span class="desktop-title">まず、一つだけつくります。</span>
          <span class="mobile-title">まず、一つだけ<br />つくります。</span>
        </h2>
        <p>Excelやスプレッドシートなど、いま使っているものをできるだけ生かします。</p>
      </div>
      <div class="process-list">
        {processSteps.map((step) => (
          <article><span>{step.number}</span><h3>{step.title}</h3><p>{step.body}</p></article>
        ))}
      </div>
      <p class="honesty-note">事業者向けの支援は立ち上げ段階で、公開できる導入事例はまだありません。まずは仕事を伺い、小さな試作から始めます。</p>
    </div>
  </section>

  <section id="case" class="section case" aria-labelledby="case-title">
    <div class="shell case-grid">
      <a class="case-image" href="https://www.neppashi.com" target="_blank" rel="noreferrer" aria-label="熱波師.COMを見る">
        <img src="/images/neppashi-site.png" alt="熱波師.COMの実際のトップページ" width="1440" height="1000" loading="lazy" />
      </a>
      <div class="case-copy">
        <p class="label">個人プロジェクト</p>
        <h2 id="case-title">
          <span class="desktop-title">こんなサイトも、つくって運営しています。</span>
          <span class="mobile-title">こんなサイトも、<br />つくって運営しています。</span>
        </h2>
        <h3>熱波師.COM</h3>
        <p class="case-summary">「出演先を探す熱波師」と「出演者を探す施設」が見つけ合える場所。</p>
        <p>Xの投稿はすぐに流れてしまいます。そこで、全国の熱波師を名前や活動地域から探し、本人へ相談できるサイトをつくりました。</p>
        <p>散らばった情報を集め、使う人に合わせて整理し、運用できる形にする。課題を見つけ、仕組みをつくり、運営してきた一例です。</p>
        <a class="text-link" href="https://www.neppashi.com" target="_blank" rel="noreferrer">実際のサイトを見る ↗</a>
        <small>熱波師.COMは店舗自動化の導入事例ではなく、城田が運営する個人プロジェクトです。</small>
      </div>
    </div>
  </section>

  <section id="about" class="section about" aria-labelledby="about-title">
    <div class="shell about-grid">
      <div>
        <p class="label light-label">私について</p>
        <h2 id="about-title">
          <span class="desktop-title">両親のガソリンスタンドが、原点です。</span>
          <span class="mobile-title">両親の<br />ガソリンスタンドが、<br />原点です。</span>
        </h2>
      </div>
      <div class="about-copy">
        <p>私の両親は、二人でガソリンスタンドを営んでいます。店の仕事が終わっても、売上管理や事務作業は残る。そんな姿を身近で見て育ちました。</p>
        <div class="career-list" aria-label="これまでの仕事">
          {career.map((item) => (
            <div class="career-row"><strong>{item.company}</strong><span>{item.body}</span></div>
          ))}
        </div>
        <p>会社やサービスが変わっても、小さなお店や個人の力になれる仕事を選んできました。現在は会社員として働きながら、個人でこの活動を始めています。</p>
        <a class="text-link light-link" href="https://note.com/pon_localization" target="_blank" rel="noreferrer">noteで制作の記録を読む ↗</a>
      </div>
    </div>
  </section>

  <section class="section faq" aria-labelledby="faq-title">
    <div class="shell faq-grid">
      <div><p class="label">相談の前に</p><h2 id="faq-title">よく聞かれること</h2></div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <article><h3>{faq.question}</h3><p>{faq.answer}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="section contact" aria-labelledby="contact-title">
    <div class="shell contact-inner">
      <p class="label">無料相談</p>
      <h2 id="contact-title">
        <span class="desktop-title">まずは、無料相談から。</span>
        <span class="mobile-title">まずは、<br />無料相談から。</span>
      </h2>
      <p>何を自動化できるか決まっていなくても大丈夫です。「毎回これが面倒」という作業を教えてください。機密情報の入力は必要ありません。</p>
      <a class="button primary-button" href="https://docs.google.com/forms/d/e/1FAIpQLSewdmS_pSjJh0LF-KO2BsjW0myrnp2NB22J7Ia7mBuuTGvjnw/viewform?usp=publish-editor" target="_blank" rel="noreferrer">無料相談を申し込む ↗</a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { background: #f4f0e6; color: #252927; }
  :global(*) { box-sizing: border-box; }
  .shell { width: min(1120px, calc(100% - 64px)); margin: 0 auto; }
  .section { padding: 104px 0; }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2 { font-family: "Zen Old Mincho", serif; color: #19384c; font-weight: 600; text-wrap: balance; }
  h1 { margin-bottom: 30px; font-size: clamp(48px, 4.4vw, 56px); line-height: 1.34; letter-spacing: -.035em; }
  h2 { margin-bottom: 0; font-size: clamp(36px, 3.6vw, 44px); line-height: 1.42; letter-spacing: -.03em; }
  h3 { font-size: 19px; line-height: 1.65; }
  p { font-size: 16px; line-height: 1.9; }
  .label { margin: 0 0 20px; color: #c94f32; font-size: 12px; font-weight: 700; letter-spacing: .09em; }
  .light-label { color: #ef9d87; }
  .button { display: inline-flex; min-height: 52px; align-items: center; justify-content: center; border: 1px solid transparent; border-radius: 2px; padding: 13px 22px; font-size: 14px; font-weight: 700; text-decoration: none; transition: background-color .2s ease; }
  .primary-button { background: #c94f32; color: #fffdf8; }
  .primary-button:hover { background: #a93c25; }
  .text-link { display: inline-flex; color: #19384c; font-size: 14px; font-weight: 700; text-decoration: underline; text-underline-offset: 5px; }

  .audience-gateway { display: flex; min-height: 720px; align-items: center; padding: 132px 0 76px; background: #f4f0e6; }
  .gateway-inner { max-width: 1000px; }
  .gateway-inner > h1 { max-width: 760px; margin-bottom: 20px; }
  .gateway-lead { max-width: 680px; margin-bottom: 40px; color: #575d58; font-size: 17px; }
  .audience-options { display: grid; grid-template-columns: repeat(2, 1fr); border: 1px solid #19384c; }
  .audience-option { display: flex; min-height: 300px; flex-direction: column; padding: 34px 38px 30px; color: inherit; text-decoration: none; transition: background-color .2s ease, color .2s ease; }
  .audience-option + .audience-option { border-left: 1px solid #19384c; }
  .business-option { background: #19384c; color: #fffdf8; }
  .business-option:hover { background: #244a62; }
  .personal-option { background: #fffdf8; }
  .personal-option:hover { background: #eee9de; }
  .option-label { margin-bottom: 24px; color: #c94f32; font-size: 12px; font-weight: 700; letter-spacing: .06em; }
  .business-option .option-label { color: #ef9d87; }
  .audience-option strong { font-family: "Zen Old Mincho", serif; font-size: 27px; font-weight: 600; line-height: 1.55; letter-spacing: -.025em; }
  .audience-option p { margin: 18px 0 28px; color: #575d58; font-size: 13px; line-height: 1.8; }
  .business-option p { color: rgba(255,253,248,.8); }
  .option-link { margin-top: auto; font-size: 13px; font-weight: 700; text-decoration: underline; text-underline-offset: 5px; }

  .hero { display: flex; min-height: 750px; align-items: center; padding: 118px 0 74px; background: #fffdf8; }
  .hero-grid { display: grid; grid-template-columns: 58fr 42fr; gap: 64px; align-items: center; }
  .hero-lead { max-width: 590px; margin-bottom: 36px; color: #4f5551; font-size: 17px; }
  .button-note { margin: 13px 0 0; color: #737873; font-size: 11px; }
  .hero-portrait { margin: 0; }
  .hero-portrait img { display: block; width: 100%; aspect-ratio: 4 / 5; border: 1px solid #19384c; object-fit: cover; object-position: 50% 34%; }
  .hero-portrait figcaption { margin-top: 10px; color: #737873; font-size: 11px; line-height: 1.6; }
  .mobile-title { display: none; }

  .section-heading { display: grid; grid-template-columns: 220px 1fr; gap: 72px; }
  .section-heading > div { display: grid; grid-template-columns: 1fr .75fr; gap: 64px; align-items: end; }
  .intro { max-width: 440px; margin-bottom: 6px; color: #575d58; }
  .manual { background: #f4f0e6; }
  .ruled-list { margin-top: 62px; border-top: 1px solid #cfc8ba; }
  .ruled-row { display: grid; grid-template-columns: 105px 1fr; gap: 26px; align-items: start; padding: 25px 0; border-bottom: 1px solid #cfc8ba; }
  .ruled-row span { padding-top: 4px; color: #c94f32; font-size: 12px; font-weight: 700; }
  .ruled-row p { margin: 0; font-size: 19px; }

  .compact-heading { display: grid; grid-template-columns: 210px 1fr .9fr; gap: 56px; align-items: end; }
  .compact-heading .label { align-self: start; }
  .compact-heading > p:last-child { margin-bottom: 5px; color: #575d58; }

  .process { background: #fffdf8; }
  .process-list { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 62px; border-top: 1px solid #cfc8ba; border-bottom: 1px solid #cfc8ba; }
  .process-list article { min-height: 205px; padding: 28px 34px; border-right: 1px solid #cfc8ba; }
  .process-list article:first-child { padding-left: 0; }
  .process-list article:last-child { border-right: 0; padding-right: 0; }
  .process-list span { color: #c94f32; font-size: 11px; font-weight: 700; }
  .process-list h3 { margin: 28px 0 12px; color: #19384c; }
  .process-list p { margin: 0; color: #575d58; font-size: 14px; }
  .honesty-note { max-width: 760px; margin: 30px 0 0 auto; border-left: 2px solid #cfc8ba; padding-left: 20px; color: #737873; font-size: 12px; line-height: 1.8; }

  .case { background: #f4f0e6; }
  .case-grid { display: grid; grid-template-columns: 7fr 5fr; gap: 68px; align-items: center; }
  .case-image { display: block; width: 100%; border: 1px solid #19384c; color: inherit; text-decoration: none; }
  .case-image img { display: block; width: 100%; height: auto; }
  .case-copy h2 { margin-bottom: 18px; font-size: 38px; }
  .case-copy h3 { margin: 0 0 25px; color: #19384c; font-size: 25px; }
  .case-copy > p { color: #4f5551; font-size: 14px; }
  .case-copy .case-summary { color: #19384c; font-size: 16px; font-weight: 700; }
  .case-copy .text-link { margin-top: 12px; }
  .case-copy small { display: block; margin-top: 22px; color: #737873; font-size: 10px; line-height: 1.7; }

  .about { background: #19384c; color: #fffdf8; }
  .about h2 { color: #fffdf8; }
  .about-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 100px; }
  .about-copy > p { color: rgba(255,253,248,.82); }
  .career-list { margin: 34px 0; border-top: 1px solid rgba(255,255,255,.25); }
  .career-row { display: grid; grid-template-columns: 110px 1fr; gap: 22px; padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,.25); }
  .career-row strong { color: #ef9d87; font-size: 13px; }
  .career-row span { color: rgba(255,253,248,.82); font-size: 13px; line-height: 1.7; }
  .light-link { color: #fffdf8; }

  .faq { background: #fffdf8; }
  .faq-grid { display: grid; grid-template-columns: .75fr 1.25fr; gap: 90px; }
  .faq-grid h2 { font-size: 36px; }
  .faq-list { border-top: 1px solid #cfc8ba; }
  .faq-list article { padding: 25px 0; border-bottom: 1px solid #cfc8ba; }
  .faq-list h3 { margin-bottom: 8px; color: #19384c; font-size: 16px; }
  .faq-list p { margin: 0; color: #575d58; font-size: 14px; }

  .contact { background: #f4f0e6; }
  .contact-inner { max-width: 780px; margin: 0 auto; }
  .contact h2 + p { max-width: 650px; margin: 28px 0 32px; color: #575d58; }
  .contact small { display: block; margin-top: 14px; color: #737873; font-size: 11px; }

  @media (max-width: 900px) {
    .shell { width: min(720px, calc(100% - 40px)); }
    .section { padding: 80px 0; }
    .audience-gateway { min-height: auto; padding: 116px 0 72px; }
    .hero-grid, .section-heading, .case-grid, .about-grid, .faq-grid { grid-template-columns: 1fr; gap: 44px; }
    .section-heading > div, .compact-heading { grid-template-columns: 1fr; gap: 24px; }
    .process-list article { padding: 28px 24px; }
    .contact-inner { max-width: 720px; margin: 0 auto; }
  }

  @media (max-width: 640px) {
    .shell { width: calc(100% - 40px); }
    .section { padding: 66px 0; }
    h1 { font-size: clamp(34px, 10vw, 40px); line-height: 1.42; }
    h2 { font-size: clamp(24px, 7.4vw, 29px); }
    p { font-size: 15px; }
    .desktop-only { display: none; }
    .desktop-title { display: none; }
    .mobile-title { display: inline; }
    .audience-gateway { padding: 96px 0 52px; }
    .gateway-inner > h1 { margin-bottom: 18px; }
    .gateway-lead { margin-bottom: 30px; font-size: 15px; }
    .audience-options { grid-template-columns: 1fr; }
    .audience-option { min-height: 0; padding: 27px 24px 25px; }
    .audience-option + .audience-option { border-top: 1px solid #19384c; border-left: 0; }
    .option-label { margin-bottom: 15px; }
    .audience-option strong { font-size: 22px; line-height: 1.5; }
    .audience-option p { margin: 12px 0 20px; font-size: 12px; }
    .hero { min-height: auto; padding: 62px 0 70px; }
    .hero-grid { display: flex; flex-direction: column; gap: 34px; }
    .hero-portrait { order: 1; width: calc(100% + 40px); margin-left: -20px; }
    .hero-portrait img { aspect-ratio: 5 / 4; border-width: 0 0 1px; object-position: 50% 28%; }
    .hero-portrait figcaption { padding: 0 20px; }
    .hero-copy { order: 2; }
    .hero-copy .label { margin-bottom: 13px; }
    .hero-lead { margin-bottom: 28px; font-size: 15px; }
    .hero .button { width: 100%; }
    .button-note { text-align: center; }
    .section-heading { gap: 25px; }
    .section-heading > div { gap: 22px; }
    .ruled-list { margin-top: 42px; }
    .ruled-row { grid-template-columns: 42px 1fr; gap: 10px; padding: 21px 0; }
    .ruled-row p { font-size: 16px; }
