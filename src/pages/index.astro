---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { HOME_META_DESCRIPTION, HOME_META_TITLE } from '../../lib/site-metadata.js';

const siteUrl = 'https://tsuyoshishirota.com';
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: '城田 剛',
  alternateName: 'Tsuyoshi Shirota',
  url: siteUrl,
  image: `${siteUrl}/images/tsuyoshi-shirota.jpg`,
  jobTitle: 'プロダクトマネージャー・AI業務自動化支援',
  description: 'カフェやジムなど、小さなお店のAI自動化を支援。売上集計、データ転記、月次レポートなどの手作業を、現場に合う仕組みに変えます。',
  sameAs: [
    'https://note.com/pon_localization',
    'https://www.neppashi.com',
  ],
};
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '小さなお店のAI自動化',
  serviceType: 'AIを活用した業務自動化支援',
  url: siteUrl,
  description: HOME_META_DESCRIPTION,
  provider: {
    '@type': 'Person',
    name: '城田 剛',
    url: siteUrl,
  },
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'カフェやジムなどの小規模店舗オーナー',
  },
  areaServed: 'JP',
};

const concerns = [
  '複数店舗の売上を、毎月ひとつのExcelへまとめている',
  '同じ内容を、予約システムや別の表へ何度も入力している',
  '数字を確認したいのに、集計が終わるまで状況が分からない',
];

const steps = [
  {
    title: 'まず、話を聞く',
    body: 'いつ、誰が、どの作業に困っているのか。普段の仕事を見ながら、AIに任せる一つを一緒に決めます。',
  },
  {
    title: '小さく作ってみる',
    body: 'いきなり大きなシステムは入れません。いまのExcelやサービスを生かして、まず動く仕組みを作ります。',
  },
  {
    title: '一緒に使って、直す',
    body: '実際の仕事で試しながら、迷わず使えるところまで調整します。作って終わりにはしません。',
  },
];

const career = [
  {
    company: '楽天株式会社',
    body: '小さな商店の売上づくりを支援。',
  },
  {
    company: 'X',
    body: '誰もが広告を配信できる仕組みに携わる。',
  },
  {
    company: 'Wix',
    body: '誰もが手頃な価格で、自分の思いを伝えるWebサイトを作れるよう支援。',
  },
  {
    company: '現在',
    body: '誰もが自分の伝えたいことを形にできる、デザインツールに携わる。',
  },
];

const faqs = [
  {
    question: 'まだ何を自動化したいか決まっていません。',
    answer: '大丈夫です。普段の仕事を伺い、AIに任せられる作業をこちらで見つけて、最初に自動化する一つをご提案します。',
  },
  {
    question: '新しいシステムを導入する必要がありますか？',
    answer: '必須ではありません。いま使っているExcelやスプレッドシート、業務サービスを生かせる方法から検討します。',
  },
  {
    question: '小さなお店でも相談できますか？',
    answer: 'むしろ、専任のIT担当者がいない小さな会社や店舗のお力になりたいと考えています。まずは今の状況をお聞かせください。',
  },
];
---

<BaseLayout
  title={HOME_META_TITLE}
  description={HOME_META_DESCRIPTION}
  ogImage="/images/tsuyoshi-shirota.jpg"
  ogImageAlt="緑の木々を背景に立つ城田剛"
  ogImageWidth={1200}
  ogImageHeight={1800}
  jsonLd={[personLd, serviceLd]}
>
  <Header slot="header" />

  <section class="hero" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="opening-note">実家は、両親ふたりで営むガソリンスタンドです。</p>
        <h1 id="hero-title">お店の面倒な手作業、<br />AIに任せませんか。</h1>
        <p class="lead">
          売上集計、Excelへの転記、月次レポート。毎月くり返す仕事をAIが代わりに進める仕組みを、いまのやり方に合わせて作ります。
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#contact">今の困りごとを話す</a>
          <span>まだ内容が固まっていなくても大丈夫です</span>
        </div>
      </div>
      <figure class="portrait-wrap">
        <img
          src="/images/tsuyoshi-shirota.jpg"
          alt="緑の木々を背景に立つ城田剛"
          width="1200"
          height="1800"
          class="portrait"
        />
        <figcaption>城田 剛。会社員をしながら、身近な仕事の自動化を作っています。</figcaption>
      </figure>
    </div>
  </section>

  <section class="section concerns" aria-labelledby="concerns-title">
    <div class="shell concerns-grid">
      <div>
        <p class="section-kicker">店を閉めたあとに</p>
        <h2 id="concerns-title">まだ、パソコン仕事が<br />残っていませんか。</h2>
      </div>
      <div class="concern-list">
        {concerns.map((concern) => (
          <div class="concern-row">
            <span aria-hidden="true">—</span>
            <p>{concern}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="service" class="section service" aria-labelledby="service-title">
    <div class="shell service-intro">
      <div>
        <p class="section-kicker light">私がお手伝いできること</p>
        <h2 id="service-title">たとえば、毎月2時間かかる<br />集計ひとつから。</h2>
      </div>
      <p>
        お店を丸ごと「DX」しようとは考えません。いちばん面倒な作業を一つ選び、AIがデータを読み、移し、まとめる流れを作ります。高価なシステムへの入れ替えは前提にしません。
      </p>
    </div>
    <div class="shell step-list">
      {steps.map((step) => (
        <article class="step-row">
          <span class="step-mark" aria-hidden="true"></span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="case" class="section case" aria-labelledby="case-title">
    <div class="shell case-heading">
      <p class="section-kicker">自分でも、こんなものを作っています</p>
      <h2 id="case-title">「出会いにくい」を解決する、<br />熱波師の検索サービス。</h2>
    </div>
    <div class="shell case-card">
      <a class="case-visual" href="https://www.neppashi.com" target="_blank" rel="noreferrer" aria-label="熱波師.COMを開く">
        <img src="/images/neppashi-site.png" alt="熱波師.COMの実際のトップページ" width="1440" height="1000" loading="lazy" />
      </a>
      <div class="case-copy">
        <p class="case-label">個人で企画・制作・運営</p>
        <h3>熱波師.COM <span aria-hidden="true">↗</span></h3>
        <p>
          Xで「出演できる施設を探しています」という熱波師と、「出演してくれる人を探しています」という施設を見かけました。求めている人は双方にいるのに、投稿はすぐ流れてしまう。ならば、見つけ合える場所を作ろうと思ったのが始まりです。
        </p>
        <ul class="case-details">
          <li>名前や活動地域から熱波師を探せる</li>
          <li>活動情報とSNSを一つのページで確認できる</li>
          <li>施設から熱波師本人へ直接相談できる</li>
        </ul>
        <p class="case-note">Webページを作るだけでなく、散らばった情報を集め、使う人に合わせて整理し、運用できる形まで作れます。</p>
        <a class="text-link" href="https://www.neppashi.com" target="_blank" rel="noreferrer">
          熱波師.COMを見る<span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section id="about" class="section about" aria-labelledby="about-title">
    <div class="shell about-grid">
      <div class="about-heading">
        <p class="section-kicker">なぜ、小さなお店なのか</p>
        <h2 id="about-title">両親の店を見て育ったから、他人事ではありません。</h2>
      </div>
      <div class="about-copy">
        <p>
          私の両親は、二人でガソリンスタンドを営んでいます。現場の仕事に加えて、売上管理や事務まで自分たちで担う姿を見てきました。
        </p>
        <p>私自身も、仕事では一貫して、小さな事業者がテクノロジーを使って前に進める状態をつくってきました。</p>
        <div class="career-list" aria-label="これまでの仕事">
          {career.map((item) => (
            <div class="career-row">
              <strong>{item.company}</strong>
              <span>{item.body}</span>
            </div>
          ))}
        </div>
        <p class="about-closing">
          会社や扱うサービスは変わっても、その軸は変わりませんでした。だから今、AIを使って、両親のように現場と事務を自分たちで背負う人の力になりたいと思っています。
        </p>
        <a class="text-link" href="https://note.com/pon_localization" target="_blank" rel="noreferrer">
          noteで制作と試行錯誤を読む<span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section faq" aria-labelledby="faq-title">
    <div class="shell faq-grid">
      <div>
        <p class="section-kicker">相談の前に</p>
        <h2 id="faq-title">よく聞かれること。</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}<span aria-hidden="true">＋</span></summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="shell contact-grid">
      <div>
        <p class="eyebrow light">お問い合わせ</p>
        <h2 id="contact-title">その手作業、AIに任せられるかもしれません。</h2>
        <p class="contact-lead">毎月繰り返している集計、転記、確認、レポート作成などを教えてください。自動化できる方法を考えます。</p>
      </div>
      <div class="contact-action">
        <p class="contact-time">入力は3分ほど</p>
        <p>お名前と連絡先、AIで自動化したい作業を伺います。まだ具体的でなくても大丈夫です。2〜3営業日を目安に城田からご連絡します。</p>
        <a
          class="button button-contact"
          href="https://docs.google.com/forms/d/e/1FAIpQLSewdmS_pSjJh0LF-KO2BsjW0myrnp2NB22J7Ia7mBuuTGvjnw/viewform?usp=publish-editor"
          target="_blank"
          rel="noreferrer"
        >
          Googleフォームで相談する<span aria-hidden="true">↗</span>
        </a>
        <p class="form-note">顧客名簿や売上データなどの機密情報は、フォームには記載しないでください。</p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { background: #f5f1e8; color: #202821; }
  :global(*) { box-sizing: border-box; }
  .shell { width: min(1120px, calc(100% - 64px)); margin: 0 auto; }
  .section { padding: 112px 0; }
  .section-kicker { margin: 0 0 18px; color: #9a5d45; font-size: 13px; font-weight: 700; letter-spacing: .08em; }
  .section-kicker.light { color: #e4b39c; }
  .eyebrow { margin: 0 0 22px; color: #294b37; font-size: 13px; font-weight: 700; letter-spacing: .12em; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { margin-bottom: 30px; font-family: "Shippori Mincho", serif; font-size: clamp(42px, 4.8vw, 66px); line-height: 1.32; letter-spacing: -.035em; font-weight: 600; }
  h2 { margin-bottom: 0; font-size: clamp(31px, 3.1vw, 44px); line-height: 1.45; letter-spacing: -.03em; font-weight: 700; }
  h3 { font-size: 25px; line-height: 1.5; font-weight: 700; }
  p { font-size: 17px; line-height: 1.9; }
  .hero { padding: 142px 0 92px; background: #fffdf8; }
  .hero-grid { display: grid; grid-template-columns: 1.18fr .82fr; align-items: center; gap: 86px; }
  .hero-copy { padding: 18px 0 52px; }
  .opening-note { display: inline-block; margin: 0 0 34px; border-bottom: 1px solid #b85f3d; padding-bottom: 5px; color: #756e64; font-size: 13px; line-height: 1.7; }
  .lead { max-width: 600px; margin-bottom: 38px; color: #4c564e; font-size: 18px; }
  .hero-actions { display: flex; align-items: center; gap: 20px; }
  .hero-actions span { color: #687169; font-size: 13px; }
  .button { display: inline-flex; min-height: 54px; align-items: center; justify-content: center; border: 1px solid transparent; border-radius: 6px; padding: 14px 24px; font-size: 15px; font-weight: 700; text-decoration: none; transition: background-color .2s ease, color .2s ease, border-color .2s ease; }
  .button-primary { background: #b85f3d; color: #fffdf8; }
  .button-primary:hover { background: #984a2f; }
  .portrait-wrap { margin: 0; }
  .portrait { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 34%; box-shadow: 18px 18px 0 #e9e3d8; }
  figcaption { margin-top: 12px; color: #687169; font-size: 12px; line-height: 1.6; }
  .concerns { background: #f5f1e8; }
  .concerns-grid { display: grid; grid-template-columns: .86fr 1.14fr; gap: 110px; align-items: start; }
  .concern-list { margin-top: 52px; border-top: 1px solid #d8d1c4; }
  .concern-row { display: grid; grid-template-columns: 28px 1fr; gap: 12px; align-items: start; padding: 23px 0; border-bottom: 1px solid #d8d1c4; }
  .concern-row span { padding-top: 4px; color: #b85f3d; font-size: 16px; }
  .concern-row p { margin: 0; font-size: 18px; line-height: 1.75; }
  .service { background: #294b37; color: #fffdf8; }
  .service .eyebrow { color: #e4b39c; }
  .service-intro { display: grid; grid-template-columns: 1.05fr .95fr; gap: 96px; align-items: end; }
  .service-intro > p { margin-bottom: 4px; color: #dce6de; }
  .step-list { margin-top: 76px; border-top: 1px solid rgba(255,255,255,.24); }
  .step-row { display: grid; grid-template-columns: 34px 230px 1fr; gap: 26px; align-items: start; padding: 34px 0; border-bottom: 1px solid rgba(255,255,255,.24); }
  .step-mark { width: 11px; height: 11px; margin-top: 13px; border-radius: 50%; background: #e4b39c; }
  .step-row h3, .step-row p { margin-bottom: 0; }
  .step-row p { color: #dce6de; }
  .text-link { display: inline-flex; gap: 7px; align-items: center; color: #294b37; font-size: 14px; font-weight: 700; text-decoration: underline; text-underline-offset: 5px; }
  .case { background: #fffdf8; }
  .case-heading { max-width: 820px; margin: 0 auto 62px; text-align: center; }
  .case-card { position: relative; padding-bottom: 85px; }
  .case-visual { display: block; width: 78%; color: inherit; text-decoration: none; box-shadow: 0 22px 60px rgba(45,37,30,.13); }
  .case-visual img { display: block; width: 100%; height: auto; border: 1px solid #d8d1c4; }
  .case-copy { position: relative; width: min(570px, 54%); margin: -115px 0 0 auto; border-top: 5px solid #b85f3d; padding: 46px 50px; background: #f5f1e8; box-shadow: 0 18px 42px rgba(45,37,30,.12); }
  .case-label { margin-bottom: 10px; color: #9a5d45; font-size: 12px; font-weight: 700; letter-spacing: .12em; }
  .case-copy h3 { margin-bottom: 24px; font-size: 33px; }
  .case-copy h3 span { color: #b85f3d; font-size: 19px; }
  .case-copy > p { color: #465048; font-size: 15px; }
  .case-details { display: grid; gap: 9px; margin: 26px 0; padding: 0; list-style: none; }
  .case-details li { position: relative; padding-left: 20px; color: #465048; font-size: 13px; line-height: 1.7; }
  .case-details li::before { position: absolute; left: 0; content: '・'; color: #b85f3d; font-weight: 900; }
  .case-note { font-weight: 700; }
  .case-copy .text-link { margin-top: 12px; }
  .about { background: #e9e3d8; }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 100px; }
  .about-copy p { color: #3d473f; }
  .career-list { margin: 34px 0; border-top: 1px solid #c9c0b2; }
  .career-row { display: grid; grid-template-columns: 110px 1fr; gap: 20px; padding: 17px 0; border-bottom: 1px solid #c9c0b2; }
  .career-row strong { color: #294b37; font-size: 14px; }
  .career-row span { color: #3d473f; font-size: 14px; line-height: 1.75; }
  .about-closing { margin-top: 30px; }
  .about-copy .text-link { margin-top: 14px; }
  .faq { background: #f5f1e8; }
  .faq-grid { display: grid; grid-template-columns: .7fr 1.3fr; gap: 96px; }
  .faq-list { border-top: 1px solid #d8d1c4; }
  details { border-bottom: 1px solid #d8d1c4; }
  summary { display: flex; min-height: 76px; cursor: pointer; align-items: center; justify-content: space-between; gap: 20px; list-style: none; font-size: 17px; font-weight: 700; }
  summary::-webkit-details-marker { display: none; }
  summary span { font-size: 20px; font-weight: 400; }
  details[open] summary span { transform: rotate(45deg); }
  details p { max-width: 650px; padding: 0 46px 24px 0; color: #4c564e; font-size: 15px; }
  .contact { padding: 112px 0; background: #202821; color: #fffdf8; }
  .contact-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 96px; }
  .eyebrow.light { color: #e4b39c; }
  .contact-lead { max-width: 470px; margin-top: 28px; color: #cbd4cd; }
  .contact-action { align-self: center; border-top: 1px solid #657168; border-bottom: 1px solid #657168; padding: 34px 0; }
  .contact-action > p { max-width: 580px; color: #d7dfd9; }
  .contact-time { margin-bottom: 12px; color: #e4b39c !important; font-size: 13px; font-weight: 700; }
  .button-contact { display: inline-flex; margin-top: 14px; gap: 10px; background: #b85f3d; color: #fff; }
  .button-contact:hover { background: #cc6c48; }
  .form-note { margin: 18px 0 0; color: #aeb8b0 !important; font-size: 12px; line-height: 1.7; }
  @media (max-width: 900px) {
    .shell { width: min(100% - 40px, 720px); }
    .section { padding: 76px 0; }
    .hero { padding: 106px 0 64px; }
    .hero-grid, .concerns-grid, .service-intro, .about-grid, .faq-grid, .contact-grid { grid-template-columns: 1fr; gap: 46px; }
    .hero-copy { padding-bottom: 0; }
    .portrait-wrap { max-width: 540px; }
    .step-row { grid-template-columns: 26px 160px 1fr; }
  }
  @media (max-width: 640px) {
    .shell { width: calc(100% - 40px); }
    .section { padding: 64px 0; }
    h1 { font-size: 38px; line-height: 1.32; letter-spacing: -.035em; }
    h2 { font-size: 29px; }
    p { font-size: 16px; }
    .hero-grid { gap: 36px; }
    .lead { font-size: 16px; }
    .hero-actions { align-items: stretch; flex-direction: column; gap: 11px; }
    .hero-actions span { text-align: center; }
    .portrait-wrap { width: calc(100% + 40px); margin-left: -20px; }
    .portrait-wrap figcaption { padding: 0 20px; }
    .concern-list { margin-top: 42px; }
    .concern-row { grid-template-columns: 28px 1fr; gap: 8px; padding: 23px 0; }
    .concern-row p { font-size: 18px; }
    .step-list { margin-top: 50px; }
    .step-row { grid-template-columns: 42px 1fr; gap: 8px 12px; }
    .step-row h3 { font-size: 21px; }
    .step-row p { grid-column: 2; font-size: 15px; }
    .case-heading { margin-bottom: 36px; text-align: left; }
    .case-card { padding-bottom: 0; }
    .case-visual { width: 100%; }
    .case-copy { width: calc(100% - 20px); margin: -28px 0 0 auto; padding: 36px 24px; }
    .case-copy h3 { font-size: 28px; }
    .about-grid, .faq-grid, .contact-grid { gap: 38px; }
    .career-row { grid-template-columns: 88px 1fr; gap: 14px; }
    summary { min-height: 70px; font-size: 15px; }
    .contact { padding: 72px 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
  }
</style>
