---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const siteUrl = 'https://tsuyoshishirota.com';
const pageUrl = `${siteUrl}/personal`;
const formUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSceWYSe7vj8NMn2YAjLSLbb7ro7KwoKAVUAMJednMf0cNVOPA/viewform';
const description = 'ChatGPTなどのAIを自分の仕事でどう使えばよいか分からない会社員へ。仕事内容や困っている作業を伺い、業務に合うAIの使い方と最初の一歩をアドバイスします。';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: '城田 剛',
  alternateName: 'Tsuyoshi Shirota',
  url: siteUrl,
  image: `${siteUrl}/images/tsuyoshi-shirota.jpg`,
  jobTitle: 'プロダクトマネージャー・AI業務自動化支援',
  description: '会社員としてAIによる業務効率化・自動化を実践し、社内でAI勉強会を行っています。',
  sameAs: ['https://note.com/pon_localization', 'https://www.neppashi.com'],
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '会社員のためのAI仕事相談',
  serviceType: 'AIを活用した業務改善相談',
  url: pageUrl,
  description,
  provider: { '@type': 'Person', name: '城田 剛', url: siteUrl },
  audience: { '@type': 'Audience', audienceType: '自分の仕事にAIを活用したい会社員' },
  areaServed: 'JP',
};

const concerns = [
  'ChatGPTは触ったけれど、検索や文章作成で止まっている',
  '自分の業務に近い事例や、具体的なやり方が見つからない',
  '職場にAIについて相談できる人がいない',
  '自動化したいけれど、どこから手をつけるか分からない',
];

const outcomes = [
  'AIに向いている仕事・向かない仕事の整理',
  '明日から試せる、具体的な使い方',
  '必要なツールと、無理なく続ける進め方',
];

const consultationSteps = [
  { number: '01', title: '仕事を伺う', body: '仕事内容や繰り返している作業を、話せる範囲で教えてください。' },
  { number: '02', title: '使いどころを見つける', body: 'AIが向いている作業と、人が判断する作業を整理します。' },
  { number: '03', title: '最初の一歩を決める', body: '明日から試せる方法や、必要なツールを具体的にアドバイスします。' },
];

const practice = [
  { title: '日々の業務', body: 'AIを使った情報整理、資料作成、繰り返し作業の効率化' },
  { title: '自動化', body: '自分の仕事に合わせた仕組みをつくり、実際に使う' },
  { title: '社内共有', body: 'AI勉強会を企画し、使い方や事例を共有' },
];

const noteArticles = [
  {
    title: 'ランサーズ・クラウドワークスの「自動化できる案件」だけをAIが自動で通知してくれるツールを作った',
    href: 'https://note.com/pon_localization/n/n9be37931fd90',
    tag: 'AIによる情報整理・通知',
  },
  {
    title: 'iOSショートカット × Claude Codeで、ブログを「1タップ半自動化」した仕組みの全体像',
    href: 'https://note.com/pon_localization/n/ne3b33f003b90',
    tag: '日々の自動化',
  },
  {
    title: '「会社の看板」を外した私は無力だった。150人の熱波師を集めるまでの泥臭い全記録',
    href: 'https://note.com/pon_localization/n/n61338ab818b7',
    tag: '個人プロジェクトの記録',
  },
];

const faqs = [
  {
    question: 'AI初心者でも相談できますか？',
    answer: 'はい。ChatGPTを少し触ったことがある程度でも大丈夫です。仕事内容を伺い、無理なく試せるところから考えます。',
  },
  {
    question: 'どんな仕事を相談できますか？',
    answer: '資料作成、情報整理、定例レポート、繰り返しの入力作業など、仕事内容に合わせてアドバイスします。',
  },
  {
    question: '会社のデータを見せる必要がありますか？',
    answer: '必要ありません。仕事内容や困っている作業を、話せる範囲で伺います。',
  },
  {
    question: '勤務先でAIを使えるか分かりません。',
    answer: '勤務先のルールをご自身で確認いただいたうえで、利用できる範囲の方法を考えます。',
  },
];
---

<BaseLayout
  title="自分の仕事のAI無料相談｜城田 剛"
  description={description}
  canonicalUrl={pageUrl}
  ogImage="/images/tsuyoshi-shirota.jpg"
  ogImageAlt="緑の木々を背景に立つ城田剛"
  ogImageWidth={1200}
  ogImageHeight={1800}
  jsonLd={[personLd, serviceLd]}
>
  <Header variant="personal" slot="header" />

  <section class="hero" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="label">会社員のためのAI仕事相談</p>
        <h1 id="hero-title">
          <span class="desktop-title">自分の仕事に合う、<br />AIの使い方を一緒に考えます。</span>
          <span class="mobile-title">自分の仕事に合う<br />AIの使い方を<br />一緒に考えます。</span>
        </h1>
        <p class="hero-lead">資料作成、情報整理、定例レポート。ChatGPTは触っているけれど、自分の仕事でどう使えばいいか分からない。そんな方の業務を伺い、何から試すとよいかをアドバイスします。</p>
        <a class="button primary-button" href="#contact">まずは無料で相談する</a>
        <p class="button-note">相談は無料です。話せる範囲の業務内容で構いません。</p>
      </div>
      <figure class="hero-portrait">
        <img src="/images/tsuyoshi-shirota.jpg" alt="緑の木々を背景に立つ城田剛" width="1200" height="1800" />
        <figcaption>城田 剛｜会社員としてAIによる業務改善・自動化を実践</figcaption>
      </figure>
    </div>
  </section>

  <section id="service" class="section concerns" aria-labelledby="concerns-title">
    <div class="shell section-heading">
      <p class="label">こんな悩みへ</p>
      <div>
        <h2 id="concerns-title">AIを使いたい。でも、自分の仕事での使い方が分からない。</h2>
        <p class="intro">知りたいのは一般的な機能ではなく、「自分のこの仕事に、どう使えるか」ではないでしょうか。</p>
      </div>
    </div>
    <div class="shell ruled-list">
      {concerns.map((concern, index) => (
        <div class="ruled-row"><span>{String(index + 1).padStart(2, '0')}</span><p>{concern}</p></div>
      ))}
    </div>
  </section>

  <section class="section outcomes" aria-labelledby="outcomes-title">
    <div class="shell outcomes-grid">
      <div>
        <p class="label">相談後に持ち帰れること</p>
        <h2 id="outcomes-title">自分の仕事で、次に何を試すかが分かります。</h2>
      </div>
      <div class="outcome-list">
        {outcomes.map((outcome, index) => (
          <div><span>{String(index + 1).padStart(2, '0')}</span><strong>{outcome}</strong></div>
        ))}
      </div>
    </div>
  </section>

  <section id="about" class="section about" aria-labelledby="about-title">
    <div class="shell about-grid">
      <div>
        <p class="label light-label">なぜ相談できるのか</p>
        <h2 id="about-title">
          <span class="desktop-title">私は、AIを<br />「仕事で使う側」です。</span>
          <span class="mobile-title">私は、AIを<br />「仕事で使う側」です。</span>
        </h2>
      </div>
      <div class="about-copy">
        <p>会社員として、AIを使った業務効率化・自動化を日々実践しています。自分の作業をラクにするだけでなく、社内でAI勉強会を開き、周囲が仕事で使えるように共有してきました。</p>
        <div class="practice-list" aria-label="AI活用の実践内容">
          {practice.map((item) => (
            <div class="practice-row"><strong>{item.title}</strong><span>{item.body}</span></div>
          ))}
        </div>
        <p>ツールを知っているだけではなく、実際の仕事へどう組み込むかを考えてきました。一般論ではなく、相談する方の業務に合わせて一緒に整理します。</p>
        <p class="career-note">楽天、X、Wix、現在のデザインツール企業で、個人や小さな事業者がテクノロジーを使えるようにする仕事に携わってきました。</p>
      </div>
    </div>
  </section>

  <section id="note" class="section note" aria-labelledby="note-title">
    <div class="shell note-grid">
      <div>
        <p class="label">実践記録</p>
        <h2 id="note-title">試したことは、noteに残しています。</h2>
        <p>自分の仕事で試したAIの使い方や自動化を、途中経過も含めて書いています。</p>
      </div>
      <div class="article-list">
        {noteArticles.map((article) => (
          <a href={article.href} target="_blank" rel="noreferrer">
            <span>{article.tag}</span><strong>{article.title}</strong><i aria-hidden="true">↗</i>
          </a>
        ))}
        <a class="all-articles" href="https://note.com/pon_localization" target="_blank" rel="noreferrer">noteの記事をすべて見る ↗</a>
      </div>
    </div>
  </section>

  <section class="section consultation" aria-labelledby="consultation-title">
    <div class="shell">
      <div class="compact-heading">
        <p class="label">無料相談の進め方</p>
        <h2 id="consultation-title">あなたの業務に合わせて、使いどころを整理します。</h2>
        <p>ツールありきではなく、いま困っている作業から考えます。</p>
      </div>
      <div class="step-list">
        {consultationSteps.map((step) => (
          <article><span>{step.number}</span><h3>{step.title}</h3><p>{step.body}</p></article>
        ))}
      </div>
      <p class="policy-note">勤務先でのAI利用については、ご自身で会社のルールをご確認ください。</p>
    </div>
  </section>

  <section class="section faq" aria-labelledby="faq-title">
    <div class="shell faq-grid">
      <div><p class="label">相談の前に</p><h2 id="faq-title">よく聞かれること</h2></div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <article><h3>{faq.question}</h3><p>{faq.answer}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="section contact" aria-labelledby="contact-title">
    <div class="shell contact-inner">
      <p class="label">無料相談</p>
      <h2 id="contact-title">
        <span class="desktop-title">自分の仕事で、何から試すかを<br />一緒に考えましょう。</span>
        <span class="mobile-title">自分の仕事で、<br />何から試すかを<br />一緒に考えましょう。</span>
      </h2>
      <p>まだ使いたいツールや自動化したい内容が決まっていなくても大丈夫です。困っている作業を、話せる範囲で教えてください。</p>
      <a class="button primary-button" href={formUrl} target="_blank" rel="noreferrer">無料相談を申し込む ↗</a>
      <small>Googleフォームが開きます。勤務先のルールを確認し、話せる範囲の仕事内容だけを入力してください。</small>
    </div>
  </section>

  <Footer role="会社員のためのAI仕事相談" showEmployeeCta={false} slot="footer" />
</BaseLayout>

<style>
  :global(html) { scroll-behavior: smooth; }
  :global(body) { background: #f4f0e6; color: #252927; }
  :global(*) { box-sizing: border-box; }
  .shell { width: min(1120px, calc(100% - 64px)); margin: 0 auto; }
  .section { padding: 104px 0; }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2 { font-family: "Zen Old Mincho", serif; color: #19384c; font-weight: 600; text-wrap: balance; }
  h1 { margin-bottom: 30px; font-size: clamp(44px, 4.15vw, 54px); line-height: 1.38; letter-spacing: -.035em; }
  h2 { margin-bottom: 0; font-size: clamp(34px, 3.4vw, 42px); line-height: 1.46; letter-spacing: -.03em; }
  h3 { font-size: 19px; line-height: 1.65; }
  p { font-size: 16px; line-height: 1.9; }
  .label { margin: 0 0 20px; color: #c94f32; font-size: 12px; font-weight: 700; letter-spacing: .09em; }
  .light-label { color: #ef9d87; }
  .button { display: inline-flex; min-height: 52px; align-items: center; justify-content: center; border: 1px solid transparent; border-radius: 2px; padding: 13px 22px; font-size: 14px; font-weight: 700; text-decoration: none; transition: background-color .2s ease; }
  .primary-button { background: #c94f32; color: #fffdf8; }
  .primary-button:hover { background: #a93c25; }
  .text-link { display: inline-flex; color: #19384c; font-size: 14px; font-weight: 700; text-decoration: underline; text-underline-offset: 5px; }
  .mobile-title { display: none; }

  .hero { display: flex; min-height: 750px; align-items: center; padding: 118px 0 74px; background: #fffdf8; }
  .hero-grid { display: grid; grid-template-columns: 58fr 42fr; gap: 64px; align-items: center; }
  .hero-lead { max-width: 620px; margin-bottom: 36px; color: #4f5551; font-size: 17px; }
  .button-note { margin: 13px 0 0; color: #737873; font-size: 11px; }
  .hero-portrait { margin: 0; }
  .hero-portrait img { display: block; width: 100%; aspect-ratio: 4 / 5; border: 1px solid #19384c; object-fit: cover; object-position: 50% 34%; }
  .hero-portrait figcaption { margin-top: 10px; color: #737873; font-size: 11px; line-height: 1.6; }

  .section-heading { display: grid; grid-template-columns: 220px 1fr; gap: 72px; }
  .section-heading > div { display: grid; grid-template-columns: 1.15fr .75fr; gap: 64px; align-items: end; }
  .intro { max-width: 440px; margin-bottom: 6px; color: #575d58; }
  .concerns { background: #f4f0e6; }
  .ruled-list { margin-top: 62px; border-top: 1px solid #cfc8ba; }
  .ruled-row { display: grid; grid-template-columns: 105px 1fr; gap: 26px; align-items: start; padding: 25px 0; border-bottom: 1px solid #cfc8ba; }
  .ruled-row span { padding-top: 4px; color: #c94f32; font-size: 12px; font-weight: 700; }
  .ruled-row p { margin: 0; font-size: 19px; }

  .outcomes { background: #fffdf8; }
  .outcomes-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 100px; align-items: start; }
  .outcome-list { border-top: 1px solid #cfc8ba; }
  .outcome-list > div { display: grid; grid-template-columns: 70px 1fr; gap: 22px; align-items: center; padding: 23px 0; border-bottom: 1px solid #cfc8ba; }
  .outcome-list span { color: #c94f32; font-size: 12px; font-weight: 700; }
  .outcome-list strong { color: #19384c; font-size: 17px; line-height: 1.7; }

  .consultation { background: #fffdf8; }
  .compact-heading { display: grid; grid-template-columns: 210px 1.1fr .8fr; gap: 56px; align-items: end; }
  .compact-heading .label { align-self: start; }
  .compact-heading > p:last-child { margin-bottom: 5px; color: #575d58; }
  .step-list { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 62px; border-top: 1px solid #cfc8ba; border-bottom: 1px solid #cfc8ba; }
  .step-list article { min-height: 215px; padding: 28px 34px; border-right: 1px solid #cfc8ba; }
  .step-list article:first-child { padding-left: 0; }
  .step-list article:last-child { border-right: 0; padding-right: 0; }
  .step-list span { color: #c94f32; font-size: 11px; font-weight: 700; }
  .step-list h3 { margin: 28px 0 12px; color: #19384c; }
  .step-list p { margin: 0; color: #575d58; font-size: 14px; }
  .policy-note { max-width: 760px; margin: 30px 0 0 auto; border-left: 2px solid #cfc8ba; padding-left: 20px; color: #737873; font-size: 12px; line-height: 1.8; }

  .about { background: #19384c; color: #fffdf8; }
  .about h2 { color: #fffdf8; }
  .about-grid { display: grid; grid-template-columns: .88fr 1.12fr; gap: 100px; }
  .about-copy > p { color: rgba(255,253,248,.82); }
  .practice-list { margin: 34px 0; border-top: 1px solid rgba(255,255,255,.25); }
  .practice-row { display: grid; grid-template-columns: 110px 1fr; gap: 22px; padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,.25); }
  .practice-row strong { color: #ef9d87; font-size: 13px; }
  .practice-row span { color: rgba(255,253,248,.82); font-size: 13px; line-height: 1.7; }
  .career-note { margin-top: 28px; border-left: 2px solid rgba(255,255,255,.3); padding-left: 20px; font-size: 13px; }

  .note { background: #f4f0e6; }
  .note-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 100px; align-items: start; }
  .note-grid > div:first-child > p:last-child { max-width: 430px; margin-top: 26px; color: #575d58; }
  .article-list { border-top: 1px solid #cfc8ba; }
  .article-list > a { display: grid; grid-template-columns: 145px 1fr 20px; gap: 22px; align-items: center; padding: 20px 0; border-bottom: 1px solid #cfc8ba; color: #19384c; text-decoration: none; }
  .article-list > a:hover strong { color: #c94f32; }
  .article-list span { color: #737873; font-size: 11px; line-height: 1.6; }
  .article-list strong { font-size: 14px; line-height: 1.75; transition: color .2s ease; }
  .article-list i { color: #c94f32; font-style: normal; }
  .article-list .all-articles { display: inline-flex; padding-top: 22px; border: 0; font-size: 13px; font-weight: 700; text-decoration: underline; text-underline-offset: 5px; }

  .faq { background: #f4f0e6; }
  .faq-grid { display: grid; grid-template-columns: .75fr 1.25fr; gap: 90px; }
  .faq-grid h2 { font-size: 36px; }
  .faq-list { border-top: 1px solid #cfc8ba; }
  .faq-list article { padding: 25px 0; border-bottom: 1px solid #cfc8ba; }
  .faq-list h3 { margin-bottom: 8px; color: #19384c; font-size: 16px; }
  .faq-list p { margin: 0; color: #575d58; font-size: 14px; }

  .contact { background: #fffdf8; }
  .contact-inner { max-width: 780px; margin: 0 auto; }
  .contact h2 + p { max-width: 650px; margin: 28px 0 32px; color: #575d58; }
  .contact small { display: block; margin-top: 14px; color: #737873; font-size: 11px; line-height: 1.7; }

  @media (max-width: 900px) {
    .shell { width: min(720px, calc(100% - 40px)); }
    .section { padding: 80px 0; }
    .hero-grid, .section-heading, .outcomes-grid, .about-grid, .note-grid, .faq-grid { grid-template-columns: 1fr; gap: 44px; }
    .section-heading > div, .compact-heading { grid-template-columns: 1fr; gap: 24px; }
    .step-list article { padding: 28px 24px; }
    .contact-inner { max-width: 720px; margin: 0 auto; }
  }

  @media (max-width: 640px) {
    .shell { width: calc(100% - 40px); }
    .section { padding: 66px 0; }
    h1 { font-size: clamp(32px, 9.6vw, 39px); line-height: 1.44; }
    h2 { font-size: clamp(24px, 7.4vw, 29px); }
    p { font-size: 15px; }
    .desktop-title { display: none; }
    .mobile-title { display: inline; }
    .hero { min-height: auto; padding: 62px 0 70px; }
    .hero-grid { display: grid; gap: 24px; }
    .hero-copy { display: contents; }
    .hero-copy .label { order: 1; margin-bottom: -10px; }
    .hero-copy h1 { order: 2; margin-bottom: 4px; }
    .hero-portrait { order: 3; width: calc(100% + 40px); margin-left: -20px; }
    .hero-portrait img { aspect-ratio: 5 / 4; border-width: 0 0 1px; object-position: 50% 28%; }
    .hero-portrait figcaption { padding: 0 20px; }
    .hero-lead { order: 4; margin: 5px 0 2px; font-size: 15px; }
    .hero .button { order: 5; width: 100%; }
    .button-note { order: 6; margin-top: -10px; text-align: center; }
    .contact .button { width: 100%; }
    .section-heading { gap: 25px; }
    .section-heading > div { gap: 22px; }
    .ruled-list { margin-top: 42px; }
    .ruled-row { grid-template-columns: 42px 1fr; gap: 10px; padding: 21px 0; }
    .ruled-row p { font-size: 16px; }
    .compact-heading { gap: 16px; }
    .compact-heading > p:last-child { margin-top: 6px; }
    .step-list { grid-template-columns: 1fr; margin-top: 42px; }
    .step-list article, .step-list article:first-child, .step-list article:last-child { min-height: 0; padding: 23px 0; border-right: 0; border-bottom: 1px solid #cfc8ba; }
    .step-list article:last-child { border-bottom: 0; }
    .step-list h3 { display: inline-block; margin: 0 0 8px 22px; }
    .step-list p { margin-left: 42px; }
    .policy-note { margin-top: 25px; }
    .outcomes-grid, .about-grid, .note-grid, .faq-grid { gap: 34px; }
    .outcome-list > div { grid-template-columns: 42px 1fr; gap: 10px; }
    .outcome-list strong { font-size: 15px; }
    .practice-row { grid-template-columns: 88px 1fr; gap: 12px; }
    .article-list > a { grid-template-columns: 1fr 18px; gap: 8px 12px; }
    .article-list span { grid-column: 1 / -1; }
    .article-list strong { grid-column: 1; }
    .article-list i { grid-column: 2; }
    .faq-grid h2 { font-size: 29px; }
    .contact-inner { width: calc(100% - 40px); }
    .contact h2 { font-size: 30px; }
  }

  @media (prefers-reduced-motion: reduce) {
